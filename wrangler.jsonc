{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare's git-connected "Workers + Static Assets" deploy model reads
  // this to find the built site — the dashboard's own setup screen for this
  // flow has no "build output directory" field, only a "Path" field (which
  // repo subdirectory to build FROM, for monorepos; unrelated, left as the
  // repo root). Without this file the platform has no way to know the build
  // output lives at dist/.
  //
  // No "main" entry point: this is a pure static site (astro.config.mjs sets
  // output: "static", no server-rendered routes), so there is no Worker
  // script to run — assets.directory alone is a complete, valid config for
  // an assets-only deployment.
  "name": "prudhvi-portfolio",
  "compatibility_date": "2026-09-04",
  // Matches the build command set in the Cloudflare dashboard during setup,
  // now also committed here rather than living only as a dashboard click —
  // the dashboard's build-command field is the one setting that was still
  // NOT reflected in this file before this change. Cloudflare's own docs
  // describe the wrangler config as the intended single source of truth for
  // a Worker's setup; this is that principle applied to the one field it
  // wasn't yet applied to. (Whether Workers Builds' CI currently reads this
  // field, versus only the dashboard setting, is genuinely unclear from
  // Cloudflare's own docs as of this write — a related feature request was
  // only recently marked resolved. Harmless if unread; it is definitely read
  // by a local `wrangler deploy`.)
  "build": {
    "command": "npm run build"
  },
  // Without this, the workers.dev subdomain route is treated as disabled and
  // returns 404 with body "error code: 1042" on every path — confirmed live:
  // https://prudhvi-portfolio.paddyramakrishna.workers.dev/ 404'd on / and on
  // a static asset both, with that exact error body, before this was added.
  // The custom domain (prudhvi.dev, once registered) is unaffected either
  // way — this only controls the free *.workers.dev preview URL.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Astro's static output is folder-per-route + index.html (e.g.
    // about/index.html for /about/) — without this, requests to a trailing-
    // slash path may not resolve to that file correctly.
    "html_handling": "auto-trailing-slash"
  }
}
