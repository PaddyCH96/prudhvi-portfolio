---
import { profile, stats, featuredProjects, experience, skills, education } from '../data/index.js';
---

<!-- ── Hero ───────────────────────────────────────────────── -->
<section id="top" style="padding-top:72px;">
  <div class="wrap">
    <p style="color:var(--muted); font-size:14px; margin-bottom:6px;">{profile.location}</p>
    <h1 style="font-size:clamp(32px,5vw,46px); margin-bottom:10px;">{profile.display}</h1>
    <p style="font-size:19px; color:var(--text-primary); margin-bottom:16px;">{profile.headline}</p>
    <p style="max-width:60ch; font-size:16.5px;">{profile.blurb}</p>

    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:22px;">
      <a class="btn btn-primary" href={`/${profile.resume}`} download>Download résumé (PDF)</a>
      <a class="btn" href={profile.github}>GitHub</a>
      <a class="btn" href={profile.linkedin}>LinkedIn</a>
      <a class="btn" href={`mailto:${profile.email}`}>Email</a>
    </div>

    <div class="stats">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat-v">{s.value}<small>{s.unit ?? ''}</small></span>
          <span class="stat-l">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── Projects ───────────────────────────────────────────── -->
<section id="projects">
  <div class="wrap">
    <h2>Selected work</h2>
    <div class="grid2">
      {featuredProjects.map((p) => (
        <article class="card">
          <p style="font-size:12px; color:var(--muted); margin-bottom:6px; letter-spacing:.04em; text-transform:uppercase;">{p.tag}</p>
          <h3 style="font-size:18px;"><a href={`/projects/${p.slug}/`} style="text-decoration:none;">{p.name}</a></h3>
          <p style="font-size:14.5px;">{p.summary}</p>
          <ul>{p.points.map((pt) => <li style="font-size:14px;">{pt}</li>)}</ul>
          <ul class="chips">{p.stack.map((t) => <li>{t}</li>)}</ul>
          <p class="card-links">
            <a href={`/projects/${p.slug}/`}>Read the case study →</a>
            {p.url && <a href={p.url} rel="noopener">Code ↗</a>}
          </p>
        </article>
      ))}
    </div>
    <p class="see-all"><a href="/projects/">See all 8 projects →</a></p>
  </div>
</section>

<!-- ── Interactive demo slots in here ─────────────────────── -->
<slot />

<!-- ── Experience ─────────────────────────────────────────── -->
<section id="experience">
  <div class="wrap">
    <h2>Experience</h2>
    {experience.map((e) => (
      <div class="job">
        <div class="job-meta">
          <strong style="font-size:15px; color:var(--text-primary);">{e.role}</strong>
          <span style="font-size:14px; color:var(--text-secondary);">{e.org}</span>
          <span style="font-size:12.5px; color:var(--muted);">{e.sector}</span>
          <span style="font-size:12.5px; color:var(--muted);">{e.dates}</span>
        </div>
        <ul>{e.points.map((pt) => <li style="font-size:14.5px;">{pt}</li>)}</ul>
      </div>
    ))}
  </div>
</section>

<!-- ── Skills + Education ─────────────────────────────────── -->
<section id="skills">
  <div class="wrap">
    <h2>Toolkit</h2>
    {skills.map((s) => (
      <div class="skillrow">
        <span class="skillgroup">{s.group}</span>
        <ul class="chips" style="margin-top:0;">{s.items.map((i) => <li>{i}</li>)}</ul>
      </div>
    ))}

    <h2 style="margin-top:40px;">Education</h2>
    {education.map((e) => (
      <div style="margin-bottom:12px;">
        <strong style="font-size:15px;">{e.title}</strong>
        <span style="color:var(--text-secondary); font-size:14.5px;"> — {e.org}</span>
        {e.detail && <div style="color:var(--muted); font-size:13px;">{e.detail}</div>}
      </div>
    ))}
  </div>
</section>

<!-- ── Contact ────────────────────────────────────────────── -->
<section id="contact">
  <div class="wrap">
    <h2>Get in touch</h2>
    <p style="max-width:56ch; font-size:16.5px;">
      I'm open to Data Analyst, BI Analyst and Analytics Engineer roles — India, UAE, or remote.
      The fastest way to reach me is email.
    </p>
    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:16px;">
      <a class="btn btn-primary" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="btn" href={profile.linkedin}>LinkedIn</a>
      <a class="btn" href={profile.github}>GitHub</a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    Built with Astro · {profile.name} · {profile.location}
  </div>
</footer>

<style>
  /* These are standalone actions, not inline prose links, so they carry a
     44px tap target. Negative margin keeps the visual spacing unchanged. */
  .see-all { margin:22px 0 0; font-size:15px; font-weight:500; }
  .see-all a { text-decoration:none; }
  .see-all a:hover { text-decoration:underline; }
  .card-links { display:flex; gap:16px; margin:5px 0 -11px; font-size:14px; font-weight:500; }
  .card-links a { text-decoration:none; padding:11px 0; }
  .card-links a:hover { text-decoration:underline; }
  .stats { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:34px; }
  .stat { background:var(--surface-1); border:1px solid var(--border); border-radius:var(--radius); padding:16px; }
  .stat-v { display:block; font-size:24px; font-weight:600; color:var(--text-primary); letter-spacing:-0.02em; }
  .stat-v small { font-size:14px; font-weight:500; color:var(--muted); margin-left:2px; }
  .stat-l { display:block; font-size:12.5px; color:var(--text-secondary); margin-top:2px; }

  .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:18px; }

  .job { display:grid; grid-template-columns:210px 1fr; gap:20px; padding:18px 0; border-top:1px solid var(--border); }
  .job:first-of-type { border-top:0; padding-top:0; }
  .job-meta { display:flex; flex-direction:column; gap:1px; }
  .job ul { margin-top:0; }

  .skillrow { display:grid; grid-template-columns:170px 1fr; gap:16px; align-items:start; padding:9px 0; border-top:1px solid var(--border); }
  .skillrow:first-of-type { border-top:0; }
  .skillgroup { font-size:13.5px; color:var(--text-primary); font-weight:500; }

  @media (max-width:760px) {
    .stats { grid-template-columns:repeat(2,1fr); }
    .grid2 { grid-template-columns:1fr; }
    .job, .skillrow { grid-template-columns:1fr; gap:8px; }
  }
</style>
