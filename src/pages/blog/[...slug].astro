---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { profile } from '../../data/index.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} — ${profile.name}`;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={title} description={post.data.description} ogType="article">
  <article>
    <section id="top">
      <div class="wrap">
        <a class="back" href="/blog/">← All writing</a>
        <p class="meta">
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          {post.data.draft && <span class="draft-flag">Draft</span>}
        </p>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <ul class="chips">{post.data.tags.map((t) => <li>{t}</li>)}</ul>
        )}
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <a href="/blog/">← All writing</a> · <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </footer>
  </article>
</Base>

<style>
  /* Height is declared, not accumulated from padding (C-9), matching the
   * identical fix on the case-study .back in projects/[slug].astro. This page
   * had never been sweep-tested before — every prior post was draft: true,
   * so dist/ never contained a real one for tests/visual/sweep.mjs to check. */
  .back {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: 14px; text-decoration: none;
    padding: 11px 0; margin: -11px 0 9px;
  }
  .back:hover { text-decoration: underline; }
  .meta { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--muted); margin-bottom: 10px; }
  .draft-flag {
    font-size: 11.5px; color: var(--accent-warm);
    border: 1px solid var(--accent-warm); border-radius: 999px; padding: 2px 9px;
  }
  /* Same reasoning as the case-study h1 in projects/[slug].astro: left-aligned
     display face, no bar, so it stays in flow with the meta line above it. */
  h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }
  .lead { font-size: 18px; max-width: 62ch; color: var(--text-primary); }

  /* Prose measure: constrain the content, not the wrapper, so every left
     edge stays on the same axis as the h1 above it. */
  .prose > :global(*) { max-width: 680px; }
  .prose :global(p),
  .prose :global(li) { font-size: 17px; line-height: 1.7; }
  .prose :global(h2) {
    font-size: 22px; text-transform: none; letter-spacing: -0.01em;
    color: var(--text-primary); margin: 36px 0 12px;
  }
  .prose :global(h3) { font-size: 18px; margin: 28px 0 10px; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--link); padding-left: 18px; margin: 22px 0;
  }
  .prose :global(blockquote p) { color: var(--text-primary); }
  .prose :global(code) {
    font-size: 14.5px; background: var(--surface-1);
    border: 1px solid var(--border); border-radius: 5px; padding: 1px 6px;
  }
  .prose :global(pre) {
    background: var(--surface-1); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 16px; overflow-x: auto;
  }
  .prose :global(pre code) { background: none; border: 0; padding: 0; }
  .prose :global(strong) { color: var(--text-primary); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--border); margin: 32px 0; }
</style>
