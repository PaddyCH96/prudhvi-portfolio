---
// Case study template. One file generates a page per project in
// src/data/projects.js — add a project there and its page appears.
import Base from '../../layouts/Base.astro';
import { projects, profile, relatedProjects, projectCountWord } from '../../data/index.js';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: {
      project,
      // Three related projects, same category first, chosen deterministically
      // in the data module. Sibling-to-sibling coverage is not the orphan
      // guarantee — /projects/ linking every case study is, and
      // tests/gates/linkgraph.test.mjs proves it against dist/.
      related: relatedProjects(project.slug),
    },
  }));
}

const { project, related } = Astro.props;
const title = `${project.name} — ${profile.name}`;
const description = project.summary;
---
<Base title={title} description={description} ogType="article">
  <article>
    <!-- ── Header ─────────────────────────────────────────── -->
    <section id="top">
      <div class="wrap">
        <a class="back" href="/projects/">← All work</a>

        <ul class="meta chips">
          <li>{project.category}</li>
          <li>{project.tag}</li>
          <li class={project.status === 'Shipped' ? 'status-shipped' : 'status-wip'}>{project.status}</li>
        </ul>

        <h1>{project.name}</h1>
        <p class="lead">{project.summary}</p>

        <div class="actions">
          {project.url
            ? <a class="btn btn-primary" href={project.url} rel="noopener">View the code ↗</a>
            : <span class="btn btn-quiet">Source not public</span>}
          <a class="btn" href="/projects/">All work</a>
        </div>
      </div>
    </section>

    <!-- ── The spine: problem → approach → outcome ─────────── -->
    <section>
      <div class="wrap narrow">
        <h2>The problem</h2>
        <p class="body">{project.problem}</p>
      </div>
    </section>

    <section>
      <div class="wrap narrow">
        <h2>What I did</h2>
        <p class="body">{project.approach}</p>
      </div>
    </section>

    <section>
      <div class="wrap narrow">
        <h2>What changed</h2>
        <p class="body outcome">{project.outcome}</p>
      </div>
    </section>

    <!-- ── Proof ──────────────────────────────────────────── -->
    <section>
      <div class="wrap narrow">
        <h2>Detail</h2>
        <ul class="proof">
          {project.points.map((pt) => <li>{pt}</li>)}
        </ul>

        <h3 class="stack-label">Built with</h3>
        <ul class="chips">
          {project.stack.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </section>

    <!-- ── Keep reading ───────────────────────────────────── -->
    <section>
      <div class="wrap">
        <h2 class="more-label">Related work</h2>
        <div class="more">
          {related.map((s) => (
            <a class="more-card" href={`/projects/${s.slug}/`}>
              <span class="more-tag">{s.category}</span>
              <span class="more-name">{s.name}</span>
              <span class="more-sum">{s.summary}</span>
            </a>
          ))}
        </div>
        <p class="all-projects"><a href="/projects/">{`All ${projectCountWord} projects →`}</a></p>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <a href="/">← {profile.name}</a> · <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </footer>
  </article>
</Base>

<style>
  /* Vertical padding brings the tap target to 44px (WCAG 2.5.5 / iOS HIG);
     the negative margin keeps the text on the same optical baseline. */
  /* Height is declared, not accumulated from padding (C-9). Without the
   * min-height this control renders 44.39px purely because 14px text at the
   * inherited line-height plus 22px of padding happens to clear the floor —
   * it would silently drop under 44 the moment either moves. */
  .back {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: 14px; text-decoration: none;
    padding: 11px 0; margin: -11px 0 9px;
  }
  .back:hover { text-decoration: underline; }

  .meta { margin: 0 0 16px; }
  .meta li { font-size: 12px; letter-spacing: 0.03em; }
  .status-shipped { color: var(--good); border-color: var(--good) !important; }
  .status-wip { color: var(--accent-warm); border-color: var(--accent-warm) !important; }

  /* Left-aligned, not the .page-header bar: this title sits in a flow with the
     back-link and meta chips above it, and a centred card there would break
     that reading order. The display face and uppercase carry the same
     identity without the container. */
  h1 {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.5vw, 56px);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .lead { font-size: 19px; max-width: 62ch; color: var(--text-primary); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  /* Non-interactive stand-in when there is no public repo. Reads as a
     statement of fact, not a button that failed. */
  .btn-quiet { color: var(--muted); cursor: default; }

  /* Reading measure — case studies are prose, not a dashboard.
     Constrain the CONTENT, not the .wrap: overriding .wrap's max-width
     re-centres the block and knocks its left edge off the h1's axis. */
  .narrow > * { max-width: 680px; }
  .body { font-size: 17px; line-height: 1.7; }

  /* The outcome carries the number, so it gets the emphasis. */
  .outcome {
    color: var(--text-primary);
    border-left: 3px solid var(--series-1);
    padding-left: 18px;
  }

  .proof { padding-left: 18px; }
  .proof li { font-size: 15.5px; margin-bottom: 10px; }
  .stack-label {
    font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--muted); font-weight: 600; margin: 28px 0 0;
  }

  /* Related row. Three cards, never seven. Gated by casestudy.test.mjs,
   * the only DSGN-04 gate that reads this file — typography and spacing
   * exempt it, by agreement with plan 03-07. */
  .more-label {
    font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--muted); font-weight: 600; margin: 0 0 16px;
  }

  .more { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  /* Height is declared, not accumulated from padding (C-9). It is twice the
   * control floor and still on the 4px rhythm. */
  .more-card {
    display: flex; flex-direction: column; justify-content: center; gap: 8px;
    min-height: 88px;
    background: var(--surface-1); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 24px;
    text-decoration: none; color: var(--text-primary);
  }
  .more-card:hover { border-color: var(--link); }
  /* --muted on the opaque --surface-1 card is 5.11:1 light / 4.85:1 dark.
   * Keep these cards opaque. */
  .more-tag { font-size: 13px; font-weight: 400; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .more-name { font-size: 20px; font-weight: 600; }
  .more-sum {
    font-size: 16px; font-weight: 400; color: var(--text-secondary); line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* The catalogue stays one click away at the point the reader has scrolled
   * furthest from the nav (D-21). Count word derived, never hardcoded. */
  .all-projects { margin: 24px 0 0; }
  .all-projects a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 8px 0;
    font-size: 16px; font-weight: 600; color: var(--link); text-decoration: none;
  }
  .all-projects a:hover { text-decoration: underline; }

  @media (max-width: 860px) { .more { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .more { grid-template-columns: 1fr; } .lead { font-size: 17px; } }
</style>
