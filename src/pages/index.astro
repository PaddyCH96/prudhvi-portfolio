---
import Base from '../layouts/Base.astro';
import Sections from '../components/Sections.astro';
import ChurnExplorer from '../components/ChurnExplorer.astro';
import { profile, site } from '../data/index.js';

const title = `${profile.name} — ${profile.headline}`;
---
<Base title={title} description={site.description}>
  <Sections>
    <ChurnExplorer />
  </Sections>
</Base>
